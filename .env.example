# Copy this file to .env and fill in real values. .env itself is gitignored.

# Generate your own with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key

# True/False. Always False in production.
DEBUG=True

# Comma-separated list of hostnames allowed to serve the app.
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional. If unset, the app falls back to a local SQLite database (sqlite dev, Postgres prod).
# Example (Neon/Render Postgres): postgres://user:password@host/dbname
# DATABASE_URL=

# User-Agent string geopy sends to Nominatim (OpenStreetMap's usage policy requires a real one).
GEOPY_USER_AGENT=raktkosh-app
